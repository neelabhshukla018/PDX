# ==============================================================================
# RogeX Environment Configuration
# ==============================================================================

# Option 1: Grok (xAI) API Key (Get yours at https://console.x.ai/)
# When GROK_API_KEY is configured, RogeX automatically uses Grok
GROK_API_KEY=
GROK_MODEL=grok-beta

# Option 2: Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Default RAG Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
