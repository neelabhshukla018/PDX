# ==============================================================================
# PDX Environment Configuration
# ==============================================================================

# Option 1: Groq API Key (Get yours at https://console.groq.com/) or Grok (https://console.x.ai/)
# When GROQ_API_KEY / GROK_API_KEY is configured, PDX automatically uses it
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Option 2: Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Default RAG Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
